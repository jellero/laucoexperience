Options -Indexes -MultiViews

RewriteEngine On
RewriteBase /

<FilesMatch "^(?:\.env(?:\.example)?|composer\.(?:json|lock)|database\.sql|phpunit\.xml|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Codice applicativo e configurazione non sono mai pubblici.
RewriteRule ^(?:bootstrap|config|inc|migrations|resources|src|storage|tests|tools|vendor)(?:/|$) - [F,L,NC]

# Il backoffice e i file statici esistenti restano serviti direttamente.
RewriteRule ^admin(?:/|$) - [L,NC]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Canonicalizza le vecchie URL .php solo per GET/HEAD; i POST conservano il body.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ / [R=301,L,NE]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]) [NC]
RewriteCond %1 !^admin/ [NC]
RewriteRule ^(.+?)\.php$ /$1 [R=301,L,NE]

# Unico front controller per pagine, form, API e 404.
RewriteRule ^ public/index.php [QSA,L]
