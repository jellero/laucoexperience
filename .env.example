APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Europe/Rome
APP_URL=https://laucoexperience.it

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lauco
DB_USER=lauco
DB_PASS=replace-me

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=16000

ADMIN_IDLE_TIMEOUT_SECONDS=7200

# Casella condivisa del backoffice. Conservare le password solo nel file .env del server.
MAIL_PASSWORD=
MAIL_IMAP_HOST=in.postassl.it
MAIL_IMAP_PORT=993
MAIL_IMAP_ENCRYPTION=ssl
MAIL_IMAP_VALIDATE_CERT=true
MAIL_IMAP_USERNAME=info@laucoexperience.it
MAIL_IMAP_PASSWORD=
MAIL_IMAP_TIMEOUT_SECONDS=20
MAIL_IMAP_SENT_FOLDER=
MAIL_IMAP_TRASH_FOLDER=

MAIL_SMTP_HOST=out.postassl.it
MAIL_SMTP_PORT=465
MAIL_SMTP_ENCRYPTION=ssl
MAIL_SMTP_USERNAME=info@laucoexperience.it
MAIL_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=info@laucoexperience.it
MAIL_FROM_NAME=Lauco Experience
MAIL_ATTACHMENT_MAX_BYTES=15728640

HTTP_USER_AGENT=LaucoExperience/1.0 (+https://laucoexperience.it)
HTTP_MAX_RESPONSE_BYTES=5000000
EVENT_IMPORT_MAX_ITEMS=40
EVENT_AI_WEB_HORIZON_DAYS=365
EVENT_AI_WEB_TARGET_EVENTS=18
EVENT_AI_WEB_MAX_EVENTS=40
EVENT_AI_WEB_MAX_TOOL_CALLS=20
